<?php
defined( 'ABSPATH' ) || exit;

global $product;

if ( ! $product ) {
	return;
}

// Imágenes: destacada + galería
$image_ids = [];

$featured_id = $product->get_image_id();
if ( $featured_id ) {
	$image_ids[] = $featured_id;
}

$gallery_ids = $product->get_gallery_image_ids();
if ( ! empty( $gallery_ids ) ) {
	$image_ids = array_merge( $image_ids, $gallery_ids );
}

// Sin imágenes → placeholder
if ( empty( $image_ids ) ) : ?>
	<div class="prs-product-gallery">
		<div class="prs-product-slide is-active" data-index="0">
			<?php echo wc_placeholder_img( 'large' ); ?>
		</div>
	</div>
	<?php
	return;
endif;
?>

<div class="prs-product-gallery" data-total="<?php echo esc_attr( count( $image_ids ) ); ?>">
	<?php foreach ( $image_ids as $index => $image_id ) : ?>
		<div class="prs-product-slide <?php echo 0 === $index ? 'is-active' : ''; ?>" data-index="<?php echo esc_attr( $index ); ?>">
			<?php echo wp_get_attachment_image( $image_id, 'large' ); ?>
		</div>
	<?php endforeach; ?>

	<?php if ( count( $image_ids ) > 1 ) : ?>
		<button class="prs-product-nav prs-prev" type="button" aria-label="<?php esc_attr_e( 'Imagen anterior', 'palancia-retro-shop' ); ?>">
			&lsaquo;
		</button>
		<button class="prs-product-nav prs-next" type="button" aria-label="<?php esc_attr_e( 'Imagen siguiente', 'palancia-retro-shop' ); ?>">
			&rsaquo;
		</button>
	<?php endif; ?>
</div>
